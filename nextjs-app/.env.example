NEXT_PUBLIC_SANITY_PROJECT_ID="<paste your project here>" # Required - The ID of your Sanity project
NEXT_PUBLIC_SANITY_DATASET="production" # Required - The dataset of your Sanity project
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-28" # Optional - The API version provided to the Sanity Client
NEXT_PUBLIC_SANITY_STUDIO_URL="" #Optional, defaults to http://localhost:3333
SANITY_API_READ_TOKEN="<paste your token here>" # Required - The read token for your Sanity project
SANITY_API_WRITE_TOKEN="" # Required for the e-shop - Editor token; the Stripe webhook saves orders and gift vouchers
NEXT_PUBLIC_BASE_URL="https://www.medifree.cz" # Used in emails and product structured data

STRIPE_SECRET_KEY="" # Required - sk_test_... locally, sk_live_... in production
STRIPE_WEBHOOK_SECRET="" # Required - whsec_... (from `stripe listen` locally, Dashboard webhook in production)
STRIPE_TERMS_CONSENT="" # Optional - "true" adds a required terms checkbox in Checkout (needs the terms URL set in Stripe Dashboard)

GMAIL_USER="" # Required - Gmail / Google Workspace address used to send all site email
GMAIL_APP_PASSWORD="" # Required - Google app password for GMAIL_USER
SHOP_ADMIN_EMAIL="info@medifree.cz" # Optional - where new-order notifications go

VOUCHER_SECRET="" # Required for gift vouchers - long random string (e.g. `openssl rand -hex 32`); keep it stable (webhook retries regenerate the same codes with it)
NEXT_PUBLIC_PACKETA_API_KEY="" # Required for physical products - Zásilkovna widget API key (client section → Nastavení → API)
